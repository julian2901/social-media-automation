# ==========================================================
#  Copia este archivo como ".env" y rellena tus valores.
#  El .env real está ignorado por Git: nunca se sube.
# ==========================================================

# ---------- Textos con Gemini ----------
GEMINI_API_KEY=

# ---------- Meta / Facebook / Instagram ----------
META_GRAPH_API_VERSION=v26.0
META_PAGE_ID=
META_PAGE_ACCESS_TOKEN=
META_INSTAGRAM_USER_ID=

# Usuario sistema: con esto el token se renueva solo y no caduca.
# Se genera en Business Manager > Configuración del negocio > Usuarios del sistema.
META_APP_ID=
META_APP_SECRET=
META_SYSTEM_USER_TOKEN=

# ---------- Firebase Hosting (Meta necesita una URL HTTPS para el video) ----------
FIREBASE_PROJECT_ID=
FIREBASE_SPARK_CONFIRMED=false
META_PUBLIC_VIDEO_BASE_URL=https://tu-proyecto.web.app

# ---------- TikTok ----------
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_PRIVACY_LEVEL=SELF_ONLY

# ---------- Identidad de la marca (la usan los textos de Gemini) ----------
# Si no las defines, los prompts usan "La marca" y un tono genérico.
MARCA_NOMBRE=Tu marca
MARCA_TONO=cercana, profesional y educativa

# ---------- Carpetas de trabajo ----------
# Rutas absolutas a donde viven tus clips y sus textos.
# Si no las defines, se buscan las carpetas "videos" y "textos" en el directorio actual.
META_VIDEO_DIR=C:\ruta\a\tus\videos
META_TEXT_DIR=C:\ruta\a\tus\textos
