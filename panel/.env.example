# ==========================================================
#  Copia este archivo como ".env" solo si necesitas cambiar rutas.
#  Si lo dejas vacío o no existe el archivo, el panel usa las rutas
#  por defecto: <repositorio>/generador y <repositorio>/publicador.
# ==========================================================

# Carpeta del generador de clips (proyecto aparte, pesa varios GB).
GENERADOR_DIR=
# Intérprete del generador, si su entorno virtual no está en la ruta estándar.
GENERADOR_PY=
# Script principal del generador.
GENERADOR_SCRIPT=

# Carpeta del publicador (por defecto, la hermana de este panel).
PUBLICADOR_DIR=
# Intérprete del publicador, si su entorno virtual no está en la ruta estándar.
PUBLICADOR_PY=
